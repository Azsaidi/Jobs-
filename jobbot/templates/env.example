# Secrets for jobbot. This file is git-ignored - never commit it.

# Claude API (AI fit scoring, CV tailoring, cover letters, import-cv). https://console.anthropic.com
ANTHROPIC_API_KEY=

# SMTP - used to send email applications from YOUR address and to email you digests.
# Gmail: smtp.gmail.com / 587 with an App Password (Google Account > Security > App passwords).
# Outlook/Office 365: smtp.office365.com / 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional job-search aggregators (broad UAE coverage: LinkedIn, Bayt, Indeed, GulfTalent... via Google Jobs)
# JSearch: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch  (free tier available)
RAPIDAPI_KEY=
# SerpApi Google Jobs: https://serpapi.com  (free tier available)
SERPAPI_KEY=

# Optional push notifications
# Telegram: create a bot with @BotFather, send it a message, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy: install the ntfy app and subscribe to the topic set in config.yaml (token only for protected topics)
NTFY_TOKEN=

# Optional: path to a Chromium binary for form filling (otherwise Playwright's own browser is used)
JOBBOT_CHROMIUM=
